{
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./css/main.css",
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "embeddedLanguageFormatting": "auto",
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "css",
    "objectWrap": "preserve",
    "printWidth": 100,
    "proseWrap": "preserve",
    "quoteProps": "consistent",
    "semi": true,
    "singleAttributePerLine": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "all",
    "useTabs": false
}